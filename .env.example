# Copy to .env in this directory for a new installation.
# Preserve your existing .env and database credentials when upgrading.
# Use unquoted values; this file is read as Java properties and by Compose.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=local_delivery
DB_USERNAME=local_delivery
DB_PASSWORD=

# Docker publishes only to this computer. Change these if a port is already in use.
# Internal service ports remain 8080 and 3000 regardless of these host settings.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Local HTTP only. Set true when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false

# Local email capture (messages stay on this computer, never sent to recipients).
MAILPIT_PORT=8025
SMTP_CAPTURE_PORT=1025
# Optional: override if the frontend is reached at a different local origin.
PUBLIC_BASE_URL=http://127.0.0.1:3000
